#!/usr/bin/env bash
# post-checkout — when a linked worktree is created via `git worktree add`,
# run waft from the new worktree to copy in any .worktreeinclude-selected
# ignored files from the main worktree.
#
# `scripts/install-hooks.sh` copies this reviewed version, together with a
# pinned waft binary, under Git's common directory. Do not point
# core.hooksPath at this tracked directory: a checked-out branch can replace
# tracked hook content before Git executes it.

set -eu

prev_head="${1:-}"
new_head="${2:-}"
branch_flag="${3:-0}"

# Only react to branch checkouts (1), not file checkouts (0).
[ "${branch_flag}" = "1" ] || exit 0

# No-op when nothing changed (e.g. `git checkout` of the current branch).
[ "${prev_head}" != "${new_head}" ] || exit 0

# Only act inside a linked worktree. In the main worktree, $GIT_DIR equals
# $GIT_COMMON_DIR; in a linked worktree they differ ($GIT_DIR points at
# .git/worktrees/<name>).
git_dir="$(git rev-parse --git-dir)"
common_dir="$(git rev-parse --git-common-dir)"
git_dir_abs="$(cd "${git_dir}" && pwd)"
common_dir_abs="$(cd "${common_dir}" && pwd)"
[ "${git_dir_abs}" != "${common_dir_abs}" ] || exit 0

# A managed installation always uses the reviewed binary snapshot next to
# this hook. WAFT/PATH are fallback mechanisms only for explicitly unmanaged
# manual hook use.
hook_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"
if [ -x "${hook_dir}/.waft-bin" ]; then
  waft_bin="${hook_dir}/.waft-bin"
elif [ -n "${WAFT:-}" ]; then
  waft_bin="${WAFT}"
elif command -v waft >/dev/null 2>&1; then
  waft_bin="waft"
else
  echo "post-checkout: waft not found on PATH; skipping worktree copy." >&2
  echo "  re-run the hook installer or set WAFT=<path-to-binary> to enable." >&2
  exit 0
fi

# Automatic operation must not inherit user-level or WAFT_* policy. Project
# policy is still loaded from the trusted source worktree, and explicit
# operational overrides such as WAFT_GIT_BACKEND remain available.
exec "${waft_bin}" --isolated
