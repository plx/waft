<script>
  const tables = Array.from(
    document.querySelectorAll<HTMLTableElement>(".sl-markdown-content table"),
  );

  const updateTable = (table: HTMLTableElement): void => {
    const isScrollable = table.scrollWidth > table.clientWidth + 1;
    if (isScrollable) {
      table.tabIndex = 0;
      table.dataset.waftScrollable = "true";
    } else if (table.dataset.waftScrollable === "true") {
      table.removeAttribute("tabindex");
      delete table.dataset.waftScrollable;
    }
  };

  const observer = new ResizeObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.target instanceof HTMLTableElement) {
        updateTable(entry.target);
      }
    });
  });

  tables.forEach((table) => {
    updateTable(table);
    observer.observe(table);
  });

  document.fonts?.ready.then(() => tables.forEach(updateTable));
</script>
