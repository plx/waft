---
import WaftMark from "./WaftMark.astro";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="waft-doc-title">
  <WaftMark />
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .waft-doc-title {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--waft-ink);
    font-size: 1.5rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .waft-doc-title :global(.waft-mark) {
    width: 30px;
    height: 30px;
  }

  .waft-doc-title:focus-visible {
    border-radius: var(--waft-radius-sm);
    outline: 2px solid var(--waft-focus);
    outline-offset: 2px;
  }
</style>
