---
import ThemeToggle from "./ThemeToggle.astro";
import { siteConfig } from "../site.config.mjs";
---

<div class="waft-mobile-preferences">
  <a
    class="waft-mobile-source"
    href={siteConfig.repository.url}
    target="_blank"
    rel="noopener noreferrer">GitHub</a
  >
  <ThemeToggle />
</div>

<style>
  .waft-mobile-preferences {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--waft-line);
  }

  .waft-mobile-source {
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    padding: 0 0.75rem;
    border: 1px solid var(--waft-line);
    border-radius: var(--waft-radius-sm);
    background: var(--waft-surface);
    color: var(--waft-ink);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: var(--waft-shadow);
  }

  .waft-mobile-source:hover,
  .waft-mobile-source:focus-visible {
    outline: 2px solid var(--waft-focus);
    outline-offset: 2px;
  }
</style>
