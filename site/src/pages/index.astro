---
import ThemeProvider from "../components/ThemeProvider.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import WaftMark from "../components/WaftMark.astro";
import { siteConfig } from "../site.config.mjs";
import "../styles/theme.css";
import "../styles/landing.css";

const siteBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const sitePath = (path: string = "") => `${siteBase}${path.replace(/^\/+/, "")}`;
const isExternal = (href: string) => /^https?:\/\//.test(href);
const resolveHref = (href: string) =>
  isExternal(href) || href.startsWith("#") ? href : sitePath(href);
const externalRel = (href: string) => (isExternal(href) ? "noopener noreferrer" : undefined);
const externalTarget = (href: string) => (isExternal(href) ? "_blank" : undefined);
const docsHref = siteConfig.docs.pages[0]?.href || "docs/";
const primaryNavLinks = siteConfig.landing.nav.filter((link) => !isExternal(link.href));
const githubHref =
  siteConfig.landing.nav.find((link) => isExternal(link.href))?.href ||
  siteConfig.repository.url;
const attributionHref = `${siteConfig.repository.url}/blob/${siteConfig.repository.defaultBranch}/design-system/ATTRIBUTION.md`;
---

<!doctype html>
<html lang={siteConfig.site.language}>
  <head>
    <ThemeProvider />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteConfig.project.title} | {siteConfig.project.tagline}</title>
    <meta name="description" content={siteConfig.project.description} />
    <meta property="og:title" content={siteConfig.project.title} />
    <meta property="og:description" content={siteConfig.project.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteConfig.site.url} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={sitePath("favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="landing-page">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-site-header>
      <div class="section-shell">
        <nav class="site-nav" aria-label="Primary navigation">
          <a class="site-nav__brand" href={sitePath()} aria-label={`${siteConfig.project.title} home`}>
            <WaftMark label="waft mark" />
            <span>{siteConfig.project.title}</span>
          </a>

          <div class="site-nav__links">
            {primaryNavLinks.map((link) => (
              <a
                class:list={["site-nav__link", { "is-active": link.href.startsWith("#") }]}
                href={resolveHref(link.href)}
                aria-current={link.href.startsWith("#") ? "page" : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>

          <div class="site-nav__actions">
            <ThemeToggle />
            <a
              class="button button--secondary"
              href={githubHref}
              target="_blank"
              rel="noopener noreferrer">GitHub</a
            >
            <a class="button button--primary" href={resolveHref(docsHref)}>Read the docs</a>
            <button
              class="site-nav__toggle"
              type="button"
              aria-label="Open navigation"
              aria-controls="mobile-nav"
              aria-expanded="false"
              data-nav-toggle
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16"></path>
              </svg>
            </button>
          </div>
        </nav>
      </div>

      <nav
        class="mobile-nav"
        id="mobile-nav"
        aria-label="Mobile navigation"
        data-nav-panel
        hidden
      >
        {siteConfig.landing.nav.map((link) => (
          <a
            class="mobile-nav__link"
            href={resolveHref(link.href)}
            target={externalTarget(link.href)}
            rel={externalRel(link.href)}
            data-nav-link
          >
            {link.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="main">
      <section class="hero section-shell" aria-labelledby="hero-title">
        <div class="hero__copy">
          <p class="eyebrow">{siteConfig.project.category}</p>
          <h1 id="hero-title">{siteConfig.landing.headline}</h1>
          <p class="hero__lede">
            {siteConfig.landing.lede.map((part) =>
              part.code ? <code>{part.text}</code> : part.text
            )}
          </p>
          <p class="hero__body">{siteConfig.landing.body}</p>

          <div class="badge-row" aria-label="Project highlights">
            {siteConfig.landing.badges.map((badge) => <span class="badge">{badge}</span>)}
          </div>

          <div class="hero__actions" id="install">
            <a class="button button--primary" href={resolveHref(siteConfig.landing.primaryCta.href)}>
              {siteConfig.landing.primaryCta.label}
              <svg class="button__icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
            <a
              class="button button--secondary"
              href={resolveHref(siteConfig.landing.secondaryCta.href)}
              target={externalTarget(siteConfig.landing.secondaryCta.href)}
              rel={externalRel(siteConfig.landing.secondaryCta.href)}
            >
              {siteConfig.landing.secondaryCta.label}
            </a>
          </div>
        </div>

        <div class="hero__visual">
          <div class="command-card" aria-labelledby="command-card-title">
            <div class="command-card__header">
              <div>
                <p class="eyebrow">Terminal</p>
                <h2 id="command-card-title">{siteConfig.landing.terminal.title}</h2>
              </div>
              <span>{siteConfig.landing.terminal.meta}</span>
            </div>
            <pre class="command-card__body"><code>{siteConfig.landing.terminal.lines.join("\n")}</code></pre>
            <button
              class="copy-button"
              type="button"
              data-copy-text={siteConfig.landing.terminal.copy}
              aria-label={`Copy command: ${siteConfig.landing.terminal.copy}`}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="8" y="8" width="11" height="12" rx="2"></rect>
                <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
              </svg>
              <span>Copy</span>
              <span class="sr-only" data-copy-status aria-live="polite"></span>
            </button>
          </div>

          <div class="transfer-panel">
            <h2>{siteConfig.landing.transfer.title}</h2>
            <p>
              <code>.worktreeinclude</code>
              {siteConfig.landing.transfer.description.replace(".worktreeinclude", "")}
            </p>
            <div class="transfer-list">
              {siteConfig.landing.transfer.includes.map((pattern) => <span>{pattern}</span>)}
            </div>
            <div class="transfer-rule">
              <strong>{siteConfig.landing.transfer.negation}</strong>
              <span>{siteConfig.landing.transfer.negationDescription}</span>
            </div>
          </div>
        </div>
      </section>

      <section class="section section--muted" id="features" aria-labelledby="features-title">
        <div class="section-shell">
          <div class="section-heading">
            <h2 id="features-title">A plan-then-execute file tool for worktrees.</h2>
          </div>
          <div class="feature-grid">
            {siteConfig.landing.features.map((feature, index) => (
              <article class="feature-card">
                <span class="feature-card__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                <p class="feature-card__eyebrow">{feature.eyebrow}</p>
                <h3>{feature.title}</h3>
                <p>{feature.body}</p>
                <a class="text-link" href={resolveHref(feature.href)}>Learn more</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section-shell docs-preview" aria-labelledby="docs-title">
        <div class="section-heading">
          <h2 id="docs-title">Documentation</h2>
        </div>
        <div class="docs-grid">
          {siteConfig.docs.pages.map((page) => (
            <article class="doc-card">
              <h3>{page.title}</h3>
              <p>{page.description}</p>
              <a class="text-link" href={resolveHref(page.href)}>Open page</a>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="section-shell site-footer__inner">
        <p>{siteConfig.project.title} / MIT / plx/waft</p>
        <nav aria-label="Footer">
          {siteConfig.landing.footerLinks.map((link) => (
            <a href={resolveHref(link.href)} target={externalTarget(link.href)} rel={externalRel(link.href)}>
              {link.label}
            </a>
          ))}
          <a href={attributionHref} target="_blank" rel="noopener noreferrer">Icon attribution</a>
        </nav>
      </div>
    </footer>

    <script>
      import "../scripts/landing.ts";
    </script>
  </body>
</html>
